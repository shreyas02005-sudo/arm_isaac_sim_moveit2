#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "my_robot"
    doc = """Generated from Composed Stage of root layer C:\\Users\\user\\AppData\\Local\\Temp\\tmpv0_k66wa\\my_robot.usdc


Generated from Composed Stage of root layer C:\\Users\\user\\AppData\\Local\\Temp\\urdf_import_my_robot_t1y_bvv2\\usdex_my_robot\\my_robot.usdc


Generated from Composed Stage of root layer C:\\Users\\user\\AppData\\Local\\Temp\\urdf_import_my_robot_t1y_bvv2\\temp_my_robot\\my_robot.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "my_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </my_robot/Physics/gripper_left_finger_joint>,
        </my_robot/Physics/gripper_right_finger_joint>,
        </my_robot/Physics/gripper_base_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </my_robot/Geometry/base_link/shoulder_link/arm_link/elbow_link/forearm_link/wrist_link/hand_link/tool_link/gripper_base_link>,
        </my_robot/Geometry/base_link/shoulder_link/arm_link/elbow_link/forearm_link/wrist_link/hand_link/tool_link/gripper_base_link/gripper_left_finger_link>,
        </my_robot/Geometry/base_link/shoulder_link/arm_link/elbow_link/forearm_link/wrist_link/hand_link/tool_link/gripper_base_link/gripper_right_finger_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link"
        {
            over "shoulder_link"
            {
                over "arm_link"
                {
                    over "elbow_link"
                    {
                        over "forearm_link"
                        {
                            over "wrist_link"
                            {
                                over "hand_link"
                                {
                                    over "tool_link"
                                    {
                                        over "gripper_base_link" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "gripper_left_finger_link" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                            }

                                            over "gripper_right_finger_link" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "gripper_left_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_right_finger_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "gripper_base_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

